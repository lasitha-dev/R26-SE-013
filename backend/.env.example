# Example environment variables for backend
# Set these paths to where you store your trained model files locally.
YOLO_MODEL_PATH=backend/components/smart_diagnostics/models/best.pt
VIT_MODEL_PATH=backend/components/smart_diagnostics/models/vision_transformer_cow_disease.pth
VIT_IMAGE_SIZE=224
YOLO_CONF_THRESHOLD=0.25
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=adrs_core

# Smart Diagnostics: paths below are relative to the backend directory.
SEGMENTER_MODEL_PATH=components/smart_diagnostics/models/mask_rcnn_cow_symptoms_refined.keras
SEGMENTER_MANIFEST_PATH=components/smart_diagnostics/models/segmenter_manifest.json
# Unvalidated operating defaults; select thresholds using held-out validation masks.
SEGMENTER_THRESHOLD=0.5
SEGMENTER_MIN_REGION_FRACTION=0.00029894770408163266
REASONING_TIMEOUT_SECONDS=30
REASONING_MAX_RETRIES=0
# MASK_RCNN_MODEL_PATH remains a temporary fallback alias when SEGMENTER_MODEL_PATH is absent.
